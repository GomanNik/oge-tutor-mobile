generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  teacher
  student
}

enum WorkspaceRole {
  admin
  teacher
  student
}

enum ExamType {
  oge
  ege
}

enum CatalogStatus {
  active
  archived
}

enum ProgramVersionStatus {
  draft
  published
  archived
}

enum TaskKind {
  short_answer
  extended_answer
  choice
}

enum ScoringRuleKind {
  historical_heuristic
  verified_reference
}

enum WorkspaceStatus {
  active
  archived
}

enum MembershipStatus {
  active
  suspended
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired
}

enum DeliveryStatus {
  queued
  sent
  failed
}

enum AccessTokenType {
  invite
  password_reset
}

enum AccessStatus {
  active
  invite_sent
  password_pending
  disabled
}

enum LessonStatus {
  planned
  rescheduled
  completed
  canceled
}

enum LessonSource {
  manual
  template
  import
}

enum HomeworkStatus {
  assigned
  submitted
  needs_revision
  reviewed
  overdue
}

enum SubmissionStatus {
  submitted
  reviewed
  needs_revision
}

enum FileScope {
  private_upload
  private_submission
  teacher_material
  shared_material
}

enum MaterialType {
  file
  link
  library
}

enum MaterialSource {
  upload
  link
  library
}

enum ProgressCoverageStatus {
  not_started
  in_progress
  assessment_needed
  assessed
}

enum ProgressMasteryLevel {
  weak
  medium
  good
  strong
}

enum ProgressSource {
  manual
  lesson_completed
  homework_result
  diagnostic
  import
}

enum NotificationType {
  progress_assessment_required
}

enum NotificationStatus {
  unread
  read
  resolved
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  passwordHash   String
  role           Role?
  displayName    String
  revision       Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  teacherProfile TeacherProfile?
  studentProfile StudentProfile?
  uploadedFiles  FileResource[]
  accessTokens   AccessToken[]
  sessions       AuthSession[]
  sessionVersion Int             @default(0)
  memberships    WorkspaceMembership[]
  sentInvitations WorkspaceInvitation[] @relation("InvitationSender")
  auditEvents    WorkspaceAuditEvent[] @relation("AuditActor")
  roleGrants     WorkspaceRoleGrant[] @relation("RoleGranter")
  roleRevocations WorkspaceRoleGrant[] @relation("RoleRevoker")
  catalogGrant CatalogGrant?
  catalogAuditEvents CatalogAuditEvent[]
  createdTaskMappings TaskMapping[] @relation("MappingCreator")
  revokedTaskMappings TaskMapping[] @relation("MappingRevoker")

  @@index([role])
}

model AuthSession {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  version   Int
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model AccessToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AccessTokenType
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
  @@index([type, expiresAt])
  @@index([expiresAt])
  @@index([usedAt])
}

model TeacherProfile {
  id        String           @id @default(cuid())
  userId    String           @unique
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  avatar    String           @default("")
  bg        String           @default("")
  settings  Json             @default("{}")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  students  StudentProfile[]
  lessons   Lesson[]
  homeworks Homework[]
  topics    MaterialTopic[]
  notices   Notification[]
  legacyWorkspace LegacyWorkspaceMapping?
}

model Workspace {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  timezone    String          @default("UTC")
  status      WorkspaceStatus @default(active)
  revision    Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  memberships WorkspaceMembership[]
  invitations WorkspaceInvitation[]
  auditEvents WorkspaceAuditEvent[]
  legacyMapping LegacyWorkspaceMapping?
  catalogSubjects Subject[]
  catalogPrograms ExamProgram[]
  catalogAuditEvents CatalogAuditEvent[]
}

model CatalogGrant {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  grantedAt DateTime @default(now())
}

model Subject {
  id String @id @default(cuid())
  scopeKey String
  workspaceId String?
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  code String
  name String
  status CatalogStatus @default(active)
  revision Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  programs ExamProgram[]

  @@unique([scopeKey, code])
  @@index([workspaceId, status, name, id])
}

model ExamProgram {
  id String @id @default(cuid())
  scopeKey String
  workspaceId String?
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  subjectId String
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  code String
  examType ExamType
  variant String
  name String
  status CatalogStatus @default(active)
  revision Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  versions ProgramVersion[]

  @@unique([scopeKey, code])
  @@unique([scopeKey, examType, subjectId, variant])
  @@index([workspaceId, status, name, id])
  @@index([subjectId, examType])
}

model ProgramVersion {
  id String @id @default(cuid())
  programId String
  program ExamProgram @relation(fields: [programId], references: [id], onDelete: Restrict)
  period String
  revisionNumber Int
  status ProgramVersionStatus @default(draft)
  sourceUrl String?
  notes String @default("")
  revision Int @default(0)
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks TaskDefinition[]
  scoringRule ScoringRule?

  @@unique([programId, period, revisionNumber])
  @@index([programId, status, period, id])
}

model TaskDefinition {
  id String @id @default(cuid())
  programVersionId String
  programVersion ProgramVersion @relation(fields: [programVersionId], references: [id], onDelete: Restrict)
  code String
  title String
  topics String[] @default([])
  position Int
  kind TaskKind
  maxScore Int?
  criteria Json @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  outgoingMappings TaskMapping[] @relation("MappingSource")
  incomingMappings TaskMapping[] @relation("MappingTarget")

  @@unique([programVersionId, code])
  @@unique([programVersionId, position])
  @@index([programVersionId, position, id])
}

model ScoringRule {
  id String @id @default(cuid())
  programVersionId String @unique
  programVersion ProgramVersion @relation(fields: [programVersionId], references: [id], onDelete: Restrict)
  kind ScoringRuleKind
  code String
  description String
  sourceUrl String?
  createdAt DateTime @default(now())
}

model TaskMapping {
  id String @id @default(cuid())
  fromTaskId String
  fromTask TaskDefinition @relation("MappingSource", fields: [fromTaskId], references: [id], onDelete: Restrict)
  toTaskId String
  toTask TaskDefinition @relation("MappingTarget", fields: [toTaskId], references: [id], onDelete: Restrict)
  reason String
  createdById String
  createdBy User @relation("MappingCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  revision Int @default(0)
  revokedAt DateTime?
  revokedById String?
  revokedBy User? @relation("MappingRevoker", fields: [revokedById], references: [id], onDelete: Restrict)
  revocationReason String?

  @@index([fromTaskId, toTaskId])
  @@index([toTaskId])
}

model CatalogAuditEvent {
  id String @id @default(cuid())
  workspaceId String?
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  actorUserId String?
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  actorKind String @default("user")
  targetType String
  targetId String
  action String
  changes Json @default("{}")
  requestId String
  occurredAt DateTime @default(now())

  @@index([workspaceId, occurredAt, id])
  @@index([targetType, targetId, occurredAt])
}

model WorkspaceMembership {
  id                  String           @id @default(cuid())
  workspaceId         String
  workspace           Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  userId              String
  user                User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  status              MembershipStatus @default(active)
  displayNameOverride String?
  revision            Int              @default(0)
  joinedAt            DateTime         @default(now())
  suspendedAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  roles               WorkspaceRoleGrant[]

  @@unique([workspaceId, userId])
  @@index([workspaceId, status, id])
  @@index([workspaceId, createdAt, id])
  @@index([userId, status])
}

model WorkspaceRoleGrant {
  id           String              @id @default(cuid())
  membershipId String
  membership   WorkspaceMembership @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  role         WorkspaceRole
  grantedAt    DateTime            @default(now())
  grantedById  String?
  grantedBy    User?               @relation("RoleGranter", fields: [grantedById], references: [id], onDelete: Restrict)
  revokedAt    DateTime?
  revokedById  String?
  revokedBy    User?               @relation("RoleRevoker", fields: [revokedById], references: [id], onDelete: Restrict)

  @@unique([membershipId, role])
}

model WorkspaceInvitation {
  id             String           @id @default(cuid())
  workspaceId    String
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  email          String
  tokenHash      String           @unique
  status         InvitationStatus @default(pending)
  deliveryStatus DeliveryStatus   @default(queued)
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  inviterUserId  String
  inviter       User             @relation("InvitationSender", fields: [inviterUserId], references: [id], onDelete: Restrict)
  revision       Int              @default(0)
  createdAt      DateTime         @default(now())
  roles          WorkspaceInvitationRole[]
  emails         WorkspaceEmailOutbox[]

  @@index([workspaceId, email, status])
  @@index([workspaceId, createdAt, id])
}

model WorkspaceInvitationRole {
  invitationId String
  invitation   WorkspaceInvitation @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  role         WorkspaceRole

  @@id([invitationId, role])
}

model WorkspaceEmailOutbox {
  id             String             @id @default(cuid())
  invitationId   String
  invitation     WorkspaceInvitation @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  revision       Int
  encryptedLink  String?
  attempts       Int                @default(0)
  nextAttemptAt  DateTime           @default(now())
  leaseUntil     DateTime?
  sentAt         DateTime?
  canceledAt     DateTime?
  lastErrorCode  String?
  createdAt      DateTime           @default(now())

  @@index([sentAt, canceledAt, nextAttemptAt])
}

model WorkspaceAuditEvent {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  actorUserId String?
  actor       User?     @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  actorKind   String    @default("user")
  targetType  String
  targetId    String
  action      String
  changes     Json      @default("{}")
  reason      String?
  requestId   String
  occurredAt  DateTime  @default(now())

  @@index([workspaceId, occurredAt, id])
}

model LegacyWorkspaceMapping {
  teacherProfileId String         @id
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Restrict)
  workspaceId      String         @unique
  workspace        Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
}

model IdempotencyRecord {
  id          String   @id @default(cuid())
  actorUserId String
  route       String
  key         String
  bodyHash    String
  response    Json
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@unique([actorUserId, route, key])
  @@index([expiresAt])
}

model StudentProfile {
  id             String                @id @default(cuid())
  userId         String                @unique
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  teacherId      String
  teacher        TeacherProfile        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  name           String
  grade          String                @default("")
  goal           String                @default("")
  avatar         String                @default("")
  bg             String                @default("")
  note           String                @default("")
  access         AccessStatus          @default(password_pending)
  settings       Json                  @default("{}")
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  lessons        Lesson[]
  homeworks      Homework[]
  progress       StudentTaskProgress[]
  historyEvents  ProgressHistory[]
  submissions    HomeworkSubmission[]
  notifications  Notification[]

  @@index([teacherId])
  @@index([teacherId, access])
  @@index([access])
}

model Lesson {
  id                String         @id @default(cuid())
  teacherId         String
  teacher           TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  studentId         String
  student           StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topic             String
  focusTaskNumbers  Int[]          @default([])
  startAt           DateTime
  endAt             DateTime
  timezone          String
  durationMinutes   Int
  status            LessonStatus   @default(planned)
  source            LessonSource   @default(manual)
  completedAt       DateTime?
  completionComment String         @default("")
  note              String         @default("")
  materials         Json           @default("[]")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  progressEvents    ProgressHistory[]
  notifications     Notification[]

  @@index([teacherId])
  @@index([studentId])
  @@index([startAt])
  @@index([teacherId, status, startAt])
  @@index([studentId, status, startAt])
}

model Homework {
  id              String               @id @default(cuid())
  teacherId       String
  teacher         TeacherProfile       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  studentId       String
  student         StudentProfile       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title           String
  description     String               @default("")
  topic           String               @default("")
  taskNumbers     Int[]                @default([])
  dueAt           DateTime
  assignedAt      DateTime             @default(now())
  submittedAt     DateTime?
  reviewedAt      DateTime?
  closedAt        DateTime?
  status          HomeworkStatus       @default(assigned)
  materials       Json                 @default("[]")
  reviewMaterials Json                 @default("[]")
  solutionFile    String               @default("")
  teacherComment  String               @default("")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  attempts        HomeworkSubmission[]

  @@index([teacherId])
  @@index([studentId])
  @@index([dueAt])
  @@index([teacherId, status, dueAt])
  @@index([studentId, status, dueAt])
}

model HomeworkSubmission {
  id             String         @id @default(cuid())
  homeworkId     String
  homework       Homework       @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fileResourceId String
  fileResource   FileResource   @relation(fields: [fileResourceId], references: [id], onDelete: Restrict)
  reviewStatus   SubmissionStatus @default(submitted)
  submittedAt    DateTime       @default(now())
  reviewedAt     DateTime?
  teacherComment String         @default("")

  @@index([homeworkId])
  @@index([studentId])
  @@index([fileResourceId])
}

model FileResource {
  id          String               @id @default(cuid())
  ownerId     String
  owner       User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  scope       FileScope            @default(private_upload)
  originalName String
  mimeType    String
  size        Int
  url         String
  storagePath String
  uploadedAt DateTime             @default(now())
  submissions HomeworkSubmission[]
  attachments MaterialAttachment[]

  @@index([ownerId])
  @@index([scope])
  @@index([uploadedAt])
}

model MaterialTopic {
  id         String               @id @default(cuid())
  teacherId  String
  teacher    TeacherProfile       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  taskNumber Int
  title      String
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  files      MaterialAttachment[]

  @@unique([teacherId, taskNumber])
  @@index([teacherId])
}

model MaterialAttachment {
  id          String         @id @default(cuid())
  topicId     String
  topic       MaterialTopic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  type        MaterialType
  source      MaterialSource
  title       String
  url         String         @default("")
  fileId      String?
  file        FileResource?  @relation(fields: [fileId], references: [id], onDelete: SetNull)
  originalName String        @default("")
  fileName    String         @default("")
  mimeType    String         @default("")
  size        Int            @default(0)
  uploadedAt  DateTime?
  createdAt   DateTime       @default(now())

  @@index([topicId])
  @@index([fileId])
}

model StudentTaskProgress {
  id                       String            @id @default(cuid())
  studentId                String
  student                  StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  taskNumber               Int
  coverageStatus           ProgressCoverageStatus @default(not_started)
  masteryLevel             ProgressMasteryLevel?
  lastAssessedMasteryLevel ProgressMasteryLevel?
  lessonCount              Int               @default(0)
  lastLessonId             String?
  lastActivityAt           DateTime?
  lastAssessedAt           DateTime?
  source                   ProgressSource    @default(manual)
  teacherComment           String            @default("")
  recommendedAction        String            @default("")
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  history                  ProgressHistory[]

  @@unique([studentId, taskNumber])
  @@index([studentId])
}

model ProgressHistory {
  id             String              @id @default(cuid())
  studentId      String
  student        StudentProfile      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  taskProgressId String?
  taskProgress   StudentTaskProgress? @relation(fields: [taskProgressId], references: [id], onDelete: SetNull)
  taskNumber     Int
  lessonId       String?
  lesson         Lesson?             @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  type           String
  source         ProgressSource
  coverageStatus ProgressCoverageStatus
  masteryLevel   ProgressMasteryLevel?
  comment        String              @default("")
  createdAt      DateTime            @default(now())

  @@index([studentId])
  @@index([studentId, createdAt])
  @@index([taskProgressId])
  @@index([lessonId])
}

model Notification {
  id         String          @id @default(cuid())
  type       NotificationType
  status     NotificationStatus @default(unread)
  teacherId  String
  teacher    TeacherProfile  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  studentId  String?
  student    StudentProfile? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  taskNumber Int?
  lessonId   String?
  lesson     Lesson?         @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  title      String
  message    String
  createdAt  DateTime        @default(now())
  resolvedAt DateTime?

  @@index([teacherId])
  @@index([studentId])
  @@index([teacherId, status])
  @@index([studentId, status])
  @@index([lessonId])
}
