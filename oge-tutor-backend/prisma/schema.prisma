generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  teacher
  student
}

enum WorkspaceRole {
  admin
  teacher
  student
}

enum ExamType {
  oge
  ege
}

enum CatalogStatus {
  active
  archived
}

enum ProgramVersionStatus {
  draft
  published
  archived
}

enum TaskKind {
  short_answer
  extended_answer
  choice
}

enum ScoringRuleKind {
  historical_heuristic
  verified_reference
}

enum WorkspaceStatus {
  active
  archived
}

enum CourseFormat {
  individual
  group
}

enum CourseStatus {
  draft
  active
  paused
  completed
  archived
}

enum CourseTeacherRole {
  lead
  assistant
  substitute
}

enum CourseTeacherStatus {
  active
  ended
}

enum EnrollmentStatus {
  invited
  active
  paused
  completed
  withdrawn
}

enum MembershipStatus {
  active
  suspended
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired
}

enum DeliveryStatus {
  queued
  sent
  failed
}

enum AccessTokenType {
  invite
  password_reset
}

enum AccessStatus {
  active
  invite_sent
  password_pending
  disabled
}

enum LessonStatus {
  planned
  rescheduled
  completed
  canceled
}

enum LessonSource {
  manual
  template
  import
}

enum LessonAttendance {
  unknown
  present
  absent
  excused
}

enum LessonResponseStatus {
  invited
  accepted
  declined
}

enum HomeworkStatus {
  assigned
  submitted
  needs_revision
  reviewed
  overdue
}

enum SubmissionStatus {
  submitted
  reviewed
  needs_revision
}

enum FileScope {
  private_upload
  private_submission
  teacher_material
  shared_material
}

enum MaterialType {
  file
  link
  library
}

enum MaterialSource {
  upload
  link
  library
}

enum ProgressCoverageStatus {
  not_started
  in_progress
  assessment_needed
  assessed
}

enum ProgressMasteryLevel {
  weak
  medium
  good
  strong
}

enum ProgressSource {
  manual
  lesson_completed
  homework_result
  diagnostic
  import
}

enum NotificationType {
  progress_assessment_required
}

enum NotificationStatus {
  unread
  read
  resolved
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  passwordHash   String
  role           Role?
  displayName    String
  revision       Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  teacherProfile TeacherProfile?
  studentProfile StudentProfile?
  uploadedFiles  FileResource[]
  accessTokens   AccessToken[]
  sessions       AuthSession[]
  sessionVersion Int             @default(0)
  memberships    WorkspaceMembership[]
  sentInvitations WorkspaceInvitation[] @relation("InvitationSender")
  auditEvents    WorkspaceAuditEvent[] @relation("AuditActor")
  roleGrants     WorkspaceRoleGrant[] @relation("RoleGranter")
  roleRevocations WorkspaceRoleGrant[] @relation("RoleRevoker")
  catalogGrant CatalogGrant?
  catalogAuditEvents CatalogAuditEvent[]
  createdTaskMappings TaskMapping[] @relation("MappingCreator")
  revokedTaskMappings TaskMapping[] @relation("MappingRevoker")
  createdEnrollments Enrollment[]
  lessonAttendanceMarks LessonParticipant[] @relation("LessonAttendanceMarker")
  assignments Assignment[]
  assignmentReviews AssignmentReview[]
  learningMaterials LearningMaterial[]
  learningProgressEvents LearningProgressEvent[]
  learningNotifications LearningNotification[]
  learningPreferences LearningNotificationPreference[]
  operatedLessonSeries LessonSeries[] @relation("LessonSeriesOperator")

  @@index([role])
}

model AuthSession {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  version   Int
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model AccessToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AccessTokenType
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
  @@index([type, expiresAt])
  @@index([expiresAt])
  @@index([usedAt])
}

model TeacherProfile {
  id        String           @id @default(cuid())
  userId    String           @unique
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  avatar    String           @default("")
  bg        String           @default("")
  settings  Json             @default("{}")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  students  StudentProfile[]
  lessons   Lesson[]
  homeworks Homework[]
  topics    MaterialTopic[]
  notices   Notification[]
  legacyWorkspace LegacyWorkspaceMapping?
}

model Workspace {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  timezone    String          @default("UTC")
  status      WorkspaceStatus @default(active)
  revision    Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  memberships WorkspaceMembership[]
  invitations WorkspaceInvitation[]
  auditEvents WorkspaceAuditEvent[]
  legacyMapping LegacyWorkspaceMapping?
  catalogSubjects Subject[]
  catalogPrograms ExamProgram[]
  catalogAuditEvents CatalogAuditEvent[]
  courses Course[]
  files FileResource[]
  learningMaterials LearningMaterial[]
  learningNotifications LearningNotification[]
  learningPreferences LearningNotificationPreference[]
}

model CatalogGrant {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  grantedAt DateTime @default(now())
}

model Subject {
  id String @id @default(cuid())
  scopeKey String
  workspaceId String?
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  code String
  name String
  status CatalogStatus @default(active)
  revision Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  programs ExamProgram[]

  @@unique([scopeKey, code])
  @@index([workspaceId, status, name, id])
}

model ExamProgram {
  id String @id @default(cuid())
  scopeKey String
  workspaceId String?
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  subjectId String
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  code String
  examType ExamType
  variant String
  name String
  status CatalogStatus @default(active)
  revision Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  versions ProgramVersion[]

  @@unique([scopeKey, code])
  @@unique([scopeKey, examType, subjectId, variant])
  @@index([workspaceId, status, name, id])
  @@index([subjectId, examType])
}

model ProgramVersion {
  id String @id @default(cuid())
  programId String
  program ExamProgram @relation(fields: [programId], references: [id], onDelete: Restrict)
  period String
  revisionNumber Int
  status ProgramVersionStatus @default(draft)
  sourceUrl String?
  notes String @default("")
  revision Int @default(0)
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks TaskDefinition[]
  scoringRule ScoringRule?
  courses Course[]
  learningMaterials LearningMaterial[]

  @@unique([programId, period, revisionNumber])
  @@index([programId, status, period, id])
}

model TaskDefinition {
  id String @id @default(cuid())
  programVersionId String
  programVersion ProgramVersion @relation(fields: [programVersionId], references: [id], onDelete: Restrict)
  code String
  title String
  topics String[] @default([])
  position Int
  kind TaskKind
  maxScore Int?
  criteria Json @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  outgoingMappings TaskMapping[] @relation("MappingSource")
  incomingMappings TaskMapping[] @relation("MappingTarget")
  learningProgressEvents LearningProgressEvent[]
  learningProjections LearningProgressProjection[]

  @@unique([programVersionId, code])
  @@unique([programVersionId, position])
  @@index([programVersionId, position, id])
}

model ScoringRule {
  id String @id @default(cuid())
  programVersionId String @unique
  programVersion ProgramVersion @relation(fields: [programVersionId], references: [id], onDelete: Restrict)
  kind ScoringRuleKind
  code String
  description String
  sourceUrl String?
  createdAt DateTime @default(now())
}

model TaskMapping {
  id String @id @default(cuid())
  fromTaskId String
  fromTask TaskDefinition @relation("MappingSource", fields: [fromTaskId], references: [id], onDelete: Restrict)
  toTaskId String
  toTask TaskDefinition @relation("MappingTarget", fields: [toTaskId], references: [id], onDelete: Restrict)
  reason String
  createdById String
  createdBy User @relation("MappingCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  revision Int @default(0)
  revokedAt DateTime?
  revokedById String?
  revokedBy User? @relation("MappingRevoker", fields: [revokedById], references: [id], onDelete: Restrict)
  revocationReason String?

  @@index([fromTaskId, toTaskId])
  @@index([toTaskId])
}

model CatalogAuditEvent {
  id String @id @default(cuid())
  workspaceId String?
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  actorUserId String?
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  actorKind String @default("user")
  targetType String
  targetId String
  action String
  changes Json @default("{}")
  requestId String
  occurredAt DateTime @default(now())

  @@index([workspaceId, occurredAt, id])
  @@index([targetType, targetId, occurredAt])
}

model WorkspaceMembership {
  id                  String           @id @default(cuid())
  workspaceId         String
  workspace           Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  userId              String
  user                User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  status              MembershipStatus @default(active)
  displayNameOverride String?
  revision            Int              @default(0)
  joinedAt            DateTime         @default(now())
  suspendedAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  roles               WorkspaceRoleGrant[]
  courseTeachers      CourseTeacher[]
  enrollments         Enrollment[]

  @@unique([workspaceId, userId])
  @@unique([id, workspaceId])
  @@index([workspaceId, status, id])
  @@index([workspaceId, createdAt, id])
  @@index([userId, status])
}

model WorkspaceRoleGrant {
  id           String              @id @default(cuid())
  membershipId String
  membership   WorkspaceMembership @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  role         WorkspaceRole
  grantedAt    DateTime            @default(now())
  grantedById  String?
  grantedBy    User?               @relation("RoleGranter", fields: [grantedById], references: [id], onDelete: Restrict)
  revokedAt    DateTime?
  revokedById  String?
  revokedBy    User?               @relation("RoleRevoker", fields: [revokedById], references: [id], onDelete: Restrict)

  @@unique([membershipId, role])
}

model WorkspaceInvitation {
  id             String           @id @default(cuid())
  workspaceId    String
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  email          String
  tokenHash      String           @unique
  status         InvitationStatus @default(pending)
  deliveryStatus DeliveryStatus   @default(queued)
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  inviterUserId  String
  inviter       User             @relation("InvitationSender", fields: [inviterUserId], references: [id], onDelete: Restrict)
  revision       Int              @default(0)
  createdAt      DateTime         @default(now())
  roles          WorkspaceInvitationRole[]
  emails         WorkspaceEmailOutbox[]

  @@index([workspaceId, email, status])
  @@index([workspaceId, createdAt, id])
}

model WorkspaceInvitationRole {
  invitationId String
  invitation   WorkspaceInvitation @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  role         WorkspaceRole

  @@id([invitationId, role])
}

model WorkspaceEmailOutbox {
  id             String             @id @default(cuid())
  invitationId   String
  invitation     WorkspaceInvitation @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  revision       Int
  encryptedLink  String?
  attempts       Int                @default(0)
  nextAttemptAt  DateTime           @default(now())
  leaseUntil     DateTime?
  sentAt         DateTime?
  canceledAt     DateTime?
  lastErrorCode  String?
  createdAt      DateTime           @default(now())

  @@index([sentAt, canceledAt, nextAttemptAt])
}

model WorkspaceAuditEvent {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  actorUserId String?
  actor       User?     @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  actorKind   String    @default("user")
  targetType  String
  targetId    String
  action      String
  changes     Json      @default("{}")
  reason      String?
  requestId   String
  occurredAt  DateTime  @default(now())

  @@index([workspaceId, occurredAt, id])
}

model LegacyWorkspaceMapping {
  teacherProfileId String         @id
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Restrict)
  workspaceId      String         @unique
  workspace        Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
}

model IdempotencyRecord {
  id          String   @id @default(cuid())
  actorUserId String
  route       String
  key         String
  bodyHash    String
  response    Json
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@unique([actorUserId, route, key])
  @@index([expiresAt])
}

model StudentProfile {
  id             String                @id @default(cuid())
  userId         String                @unique
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  teacherId      String
  teacher        TeacherProfile        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  name           String
  grade          String                @default("")
  goal           String                @default("")
  avatar         String                @default("")
  bg             String                @default("")
  note           String                @default("")
  access         AccessStatus          @default(password_pending)
  settings       Json                  @default("{}")
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  lessons        Lesson[]
  homeworks      Homework[]
  progress       StudentTaskProgress[]
  historyEvents  ProgressHistory[]
  submissions    HomeworkSubmission[]
  notifications  Notification[]
  legacyCourseMapping LegacyCourseMapping?

  @@index([teacherId])
  @@index([teacherId, access])
  @@index([access])
}

model Course {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  programVersionId String
  programVersion ProgramVersion @relation(fields: [programVersionId], references: [id], onDelete: Restrict)
  title String
  defaultFormat CourseFormat
  capacity Int
  startsOn DateTime @db.Date
  endsOn DateTime? @db.Date
  timezone String
  status CourseStatus @default(draft)
  revision Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  teachers CourseTeacher[]
  enrollments Enrollment[]
  lessons Lesson[]
  lessonSeries LessonSeries[]
  legacyMapping LegacyCourseMapping?
  assignments Assignment[]
  materialPublications MaterialPublication[]

  @@unique([id, workspaceId])
  @@index([workspaceId, status, createdAt, id])
  @@index([workspaceId, programVersionId, status])
}

model CourseTeacher {
  id String @id @default(cuid())
  workspaceId String
  courseId String
  course Course @relation(fields: [courseId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  membershipId String
  membership WorkspaceMembership @relation(fields: [membershipId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  role CourseTeacherRole
  status CourseTeacherStatus @default(active)
  startsOn DateTime @db.Date
  endsOn DateTime? @db.Date
  revision Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lessonTeachers LessonTeacher[]
  seriesTeachers LessonSeriesTeacher[]

  @@unique([id, courseId])
  @@index([courseId, status, role])
  @@index([membershipId, status])
}

model Enrollment {
  id String @id @default(cuid())
  workspaceId String
  courseId String
  course Course @relation(fields: [courseId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  membershipId String
  membership WorkspaceMembership @relation(fields: [membershipId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  status EnrollmentStatus @default(invited)
  startsOn DateTime? @db.Date
  endsOn DateTime? @db.Date
  goal String @default("")
  note String @default("")
  createdByUserId String?
  createdBy User? @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  revision Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  legacyMapping LegacyCourseMapping?
  lessonParticipants LessonParticipant[]
  seriesParticipants LessonSeriesParticipant[]
  assignmentRecipients AssignmentRecipient[]
  materialRecipients MaterialPublicationRecipient[]
  learningProgressEvents LearningProgressEvent[]
  learningProjections LearningProgressProjection[]

  @@unique([id, courseId])
  @@index([courseId, status, createdAt, id])
  @@index([membershipId, status])
}

model LegacyCourseMapping {
  studentProfileId String @id
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  courseId String @unique
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  enrollmentId String @unique
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
}

model Lesson {
  id                String         @id @default(cuid())
  courseId          String
  course            Course         @relation(fields: [courseId], references: [id], onDelete: Restrict)
  teacherId         String?
  teacher           TeacherProfile? @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  studentId         String?
  student           StudentProfile? @relation(fields: [studentId], references: [id], onDelete: Restrict)
  topic             String
  focusTaskNumbers  Int[]          @default([])
  startAt           DateTime
  endAt             DateTime
  timezone          String
  durationMinutes   Int
  status            LessonStatus   @default(planned)
  format            CourseFormat   @default(individual)
  revision          Int            @default(0)
  source            LessonSource   @default(manual)
  seriesId          String?
  series            LessonSeries? @relation(fields: [seriesId, courseId], references: [id, courseId], onDelete: Restrict)
  seriesRevision    Int?
  seriesOccurrenceKey String?
  seriesException   Boolean @default(false)
  completedAt       DateTime?
  completionComment String         @default("")
  note              String         @default("")
  materials         Json           @default("[]")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  progressEvents    ProgressHistory[]
  notifications     Notification[]
  lessonTeachers    LessonTeacher[]
  participants      LessonParticipant[]
  materialPublications MaterialPublication[]

  @@unique([id, courseId])
  @@unique([seriesId, seriesRevision, seriesOccurrenceKey])
  @@index([seriesId, startAt])
  @@index([courseId, status, startAt, id])
  @@index([teacherId])
  @@index([studentId])
  @@index([startAt])
  @@index([teacherId, status, startAt])
  @@index([studentId, status, startAt])
}

enum LessonSeriesStatus {
  active
  paused
  canceled
  completed
}

enum LessonSeriesFrequency {
  daily
  weekly
  monthly
}

model LessonSeries {
  id String @id @default(cuid())
  courseId String
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  topic String
  note String @default("")
  format CourseFormat
  startsAtLocal String
  untilLocalDate String
  timezone String
  frequency LessonSeriesFrequency
  interval Int @default(1)
  weekdays Int[] @default([])
  monthDays Int[] @default([])
  excludedDates String[] @default([])
  durationMinutes Int
  materializeDays Int @default(45)
  dstDisambiguation String @default("reject")
  status LessonSeriesStatus @default(active)
  revision Int @default(0)
  generation Int @default(0)
  operatorUserId String
  operator User @relation("LessonSeriesOperator", fields: [operatorUserId], references: [id], onDelete: Restrict)
  operatorRole WorkspaceRole
  nextRunAt DateTime @default(now())
  failures Int @default(0)
  lastErrorCode String @default("")
  materializedThrough DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  teachers LessonSeriesTeacher[]
  participants LessonSeriesParticipant[]
  lessons Lesson[]

  @@unique([id, courseId])
  @@index([courseId, status, createdAt, id])
  @@index([status, nextRunAt])
}

model LessonSeriesTeacher {
  seriesId String
  courseId String
  series LessonSeries @relation(fields: [seriesId, courseId], references: [id, courseId], onDelete: Restrict)
  courseTeacherId String
  courseTeacher CourseTeacher @relation(fields: [courseTeacherId, courseId], references: [id, courseId], onDelete: Restrict)

  @@id([seriesId, courseTeacherId])
  @@index([courseTeacherId])
}

model LessonSeriesParticipant {
  seriesId String
  courseId String
  series LessonSeries @relation(fields: [seriesId, courseId], references: [id, courseId], onDelete: Restrict)
  enrollmentId String
  enrollment Enrollment @relation(fields: [enrollmentId, courseId], references: [id, courseId], onDelete: Restrict)

  @@id([seriesId, enrollmentId])
  @@index([enrollmentId])
}

model LegacyCutover {
  id String @id
  cutoverAt DateTime @default(now())
}

model LessonTeacher {
  id String @id @default(cuid())
  lessonId String
  courseId String
  lesson Lesson @relation(fields: [lessonId, courseId], references: [id, courseId], onDelete: Restrict)
  courseTeacherId String
  courseTeacher CourseTeacher @relation(fields: [courseTeacherId, courseId], references: [id, courseId], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@unique([lessonId, courseTeacherId])
  @@index([courseTeacherId])
}

model LessonParticipant {
  id String @id @default(cuid())
  lessonId String
  courseId String
  lesson Lesson @relation(fields: [lessonId, courseId], references: [id, courseId], onDelete: Restrict)
  enrollmentId String
  enrollment Enrollment @relation(fields: [enrollmentId, courseId], references: [id, courseId], onDelete: Restrict)
  responseStatus LessonResponseStatus @default(invited)
  attendance LessonAttendance @default(unknown)
  attendanceMarkedAt DateTime?
  attendanceMarkedByUserId String?
  attendanceMarkedBy User? @relation("LessonAttendanceMarker", fields: [attendanceMarkedByUserId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@unique([lessonId, enrollmentId])
  @@index([enrollmentId])
}

model Homework {
  id              String               @id @default(cuid())
  teacherId       String
  teacher         TeacherProfile       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  studentId       String
  student         StudentProfile       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title           String
  description     String               @default("")
  topic           String               @default("")
  taskNumbers     Int[]                @default([])
  dueAt           DateTime
  assignedAt      DateTime             @default(now())
  submittedAt     DateTime?
  reviewedAt      DateTime?
  closedAt        DateTime?
  status          HomeworkStatus       @default(assigned)
  materials       Json                 @default("[]")
  reviewMaterials Json                 @default("[]")
  solutionFile    String               @default("")
  teacherComment  String               @default("")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  attempts        HomeworkSubmission[]

  @@index([teacherId])
  @@index([studentId])
  @@index([dueAt])
  @@index([teacherId, status, dueAt])
  @@index([studentId, status, dueAt])
}

model HomeworkSubmission {
  id             String         @id @default(cuid())
  homeworkId     String
  homework       Homework       @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fileResourceId String
  fileResource   FileResource   @relation(fields: [fileResourceId], references: [id], onDelete: Restrict)
  reviewStatus   SubmissionStatus @default(submitted)
  submittedAt    DateTime       @default(now())
  reviewedAt     DateTime?
  teacherComment String         @default("")

  @@index([homeworkId])
  @@index([studentId])
  @@index([fileResourceId])
}

model FileResource {
  id          String               @id @default(cuid())
  ownerId     String
  owner       User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  scope       FileScope            @default(private_upload)
  originalName String
  mimeType    String
  size        Int
  url         String
  storagePath String
  uploadedAt DateTime             @default(now())
  submissions HomeworkSubmission[]
  attachments MaterialAttachment[]
  workspaceId String?
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  checksum String?
  assignmentFiles AssignmentFile[]
  submissionFiles AssignmentSubmissionFile[]
  reviewFiles AssignmentReviewFile[]
  learningMaterials LearningMaterial[]

  @@index([ownerId])
  @@index([scope])
  @@index([uploadedAt])
  @@index([workspaceId, ownerId])
}

enum AssignmentStatus {
  draft
  published
  closed
  archived
}

enum AssignmentRecipientStatus {
  assigned
  submitted
  needs_revision
  reviewed
  exempted
  closed
}

enum AssignmentReviewStatus {
  draft
  published
}

enum AssignmentReviewDecision {
  accepted
  rework
}

model Assignment {
  id String @id @default(cuid())
  courseId String
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  title String
  instructions String @default("")
  taskDefinitionIds String[] @default([])
  taskSnapshot Json @default("[]")
  dueAt DateTime
  status AssignmentStatus @default(draft)
  revision Int @default(0)
  createdByUserId String?
  createdBy User? @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  publishedAt DateTime?
  closedAt DateTime?
  closeReason String @default("")
  legacyHomeworkId String? @unique
  legacyState Json @default("{}")
  legacyMaterials Json @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  files AssignmentFile[]
  recipients AssignmentRecipient[]

  @@unique([id, courseId])
  @@index([courseId, status, dueAt, id])
}

model AssignmentFile {
  assignmentId String
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  fileId String
  file FileResource @relation(fields: [fileId], references: [id], onDelete: Restrict)
  @@id([assignmentId, fileId])
  @@index([fileId])
}

model AssignmentRecipient {
  id String @id @default(cuid())
  assignmentId String
  courseId String
  assignment Assignment @relation(fields: [assignmentId, courseId], references: [id, courseId], onDelete: Restrict)
  enrollmentId String
  enrollment Enrollment @relation(fields: [enrollmentId, courseId], references: [id, courseId], onDelete: Restrict)
  dueAt DateTime
  status AssignmentRecipientStatus @default(assigned)
  reason String @default("")
  revision Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  submissions AssignmentSubmission[]
  @@unique([assignmentId, enrollmentId])
  @@index([enrollmentId, status, dueAt])
}

model AssignmentSubmission {
  id String @id @default(cuid())
  recipientId String
  recipient AssignmentRecipient @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  attempt Int
  text String @default("")
  contentSnapshot Json
  legacySubmissionId String? @unique
  submittedAt DateTime @default(now())
  files AssignmentSubmissionFile[]
  reviews AssignmentReview[]
  @@unique([recipientId, attempt])
}

model AssignmentSubmissionFile {
  submissionId String
  submission AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  fileId String
  file FileResource @relation(fields: [fileId], references: [id], onDelete: Restrict)
  @@id([submissionId, fileId])
  @@index([fileId])
}

model AssignmentReview {
  id String @id @default(cuid())
  submissionId String
  submission AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  number Int
  revision Int @default(0)
  status AssignmentReviewStatus @default(draft)
  decision AssignmentReviewDecision
  comment String @default("")
  scores Json @default("[]")
  reason String @default("")
  reviewerUserId String?
  reviewer User? @relation(fields: [reviewerUserId], references: [id], onDelete: Restrict)
  source String @default("user")
  legacyMaterials Json @default("[]")
  createdAt DateTime @default(now())
  publishedAt DateTime?
  files AssignmentReviewFile[]
  @@unique([submissionId, number])
}

model AssignmentReviewFile {
  reviewId String
  review AssignmentReview @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  fileId String
  file FileResource @relation(fields: [fileId], references: [id], onDelete: Restrict)
  @@id([reviewId, fileId])
  @@index([fileId])
}

model LearningMaterial {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  programVersionId String
  programVersion ProgramVersion @relation(fields: [programVersionId], references: [id], onDelete: Restrict)
  taskDefinitionIds String[] @default([])
  title String
  description String @default("")
  url String @default("")
  fileId String?
  file FileResource? @relation(fields: [fileId], references: [id], onDelete: Restrict)
  createdByUserId String
  legacyAttachmentId String? @unique
  legacyState Json @default("{}")
  createdBy User @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  revision Int @default(0)
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  publications MaterialPublication[]
  @@index([workspaceId, programVersionId, archivedAt, createdAt, id])
}

model MaterialPublication {
  id String @id @default(cuid())
  materialId String
  material LearningMaterial @relation(fields: [materialId], references: [id], onDelete: Restrict)
  courseId String
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  lessonId String?
  lesson Lesson? @relation(fields: [lessonId, courseId], references: [id, courseId], onDelete: Restrict)
  publishedAt DateTime @default(now())
  revokedAt DateTime?
  revision Int @default(0)
  recipients MaterialPublicationRecipient[]
  @@unique([id, courseId])
  @@index([courseId, revokedAt])
}

model MaterialPublicationRecipient {
  publicationId String
  courseId String
  publication MaterialPublication @relation(fields: [publicationId, courseId], references: [id, courseId], onDelete: Restrict)
  enrollmentId String
  enrollment Enrollment @relation(fields: [enrollmentId, courseId], references: [id, courseId], onDelete: Restrict)
  @@id([publicationId, enrollmentId])
  @@index([enrollmentId])
}

model MaterialTopic {
  id         String               @id @default(cuid())
  teacherId  String
  teacher    TeacherProfile       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  taskNumber Int
  title      String
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  files      MaterialAttachment[]

  @@unique([teacherId, taskNumber])
  @@index([teacherId])
}

model MaterialAttachment {
  id          String         @id @default(cuid())
  topicId     String
  topic       MaterialTopic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  type        MaterialType
  source      MaterialSource
  title       String
  url         String         @default("")
  fileId      String?
  file        FileResource?  @relation(fields: [fileId], references: [id], onDelete: SetNull)
  originalName String        @default("")
  fileName    String         @default("")
  mimeType    String         @default("")
  size        Int            @default(0)
  uploadedAt  DateTime?
  createdAt   DateTime       @default(now())

  @@index([topicId])
  @@index([fileId])
}

model StudentTaskProgress {
  id                       String            @id @default(cuid())
  studentId                String
  student                  StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  taskNumber               Int
  coverageStatus           ProgressCoverageStatus @default(not_started)
  masteryLevel             ProgressMasteryLevel?
  lastAssessedMasteryLevel ProgressMasteryLevel?
  lessonCount              Int               @default(0)
  lastLessonId             String?
  lastActivityAt           DateTime?
  lastAssessedAt           DateTime?
  source                   ProgressSource    @default(manual)
  teacherComment           String            @default("")
  recommendedAction        String            @default("")
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  history                  ProgressHistory[]

  @@unique([studentId, taskNumber])
  @@index([studentId])
}

model ProgressHistory {
  id             String              @id @default(cuid())
  studentId      String
  student        StudentProfile      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  taskProgressId String?
  taskProgress   StudentTaskProgress? @relation(fields: [taskProgressId], references: [id], onDelete: SetNull)
  taskNumber     Int
  lessonId       String?
  lesson         Lesson?             @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  type           String
  source         ProgressSource
  coverageStatus ProgressCoverageStatus
  masteryLevel   ProgressMasteryLevel?
  comment        String              @default("")
  createdAt      DateTime            @default(now())

  @@index([studentId])
  @@index([studentId, createdAt])
  @@index([taskProgressId])
  @@index([lessonId])
}

model Notification {
  id         String          @id @default(cuid())
  type       NotificationType
  status     NotificationStatus @default(unread)
  teacherId  String
  teacher    TeacherProfile  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  studentId  String?
  student    StudentProfile? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  taskNumber Int?
  lessonId   String?
  lesson     Lesson?         @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  title      String
  message    String
  createdAt  DateTime        @default(now())
  resolvedAt DateTime?

  @@index([teacherId])
  @@index([studentId])
  @@index([teacherId, status])
  @@index([studentId, status])
  @@index([lessonId])
}

enum LearningProgressSource {
  manual
  diagnostic
  lesson
  submission
  legacy_unknown
}

enum LearningProgressKind {
  assessment
  activity
  retraction
  snapshot
}

enum LearningVisibility {
  private
  published
}

enum LearningDeliveryStatus {
  queued
  processing
  sent
  failed
  skipped
  dev_preview
}

model LearningProgressEvent {
  id String @id @default(cuid())
  enrollmentId String
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  taskDefinitionId String?
  taskDefinition TaskDefinition? @relation(fields: [taskDefinitionId], references: [id], onDelete: Restrict)
  source LearningProgressSource
  sourceKey String @unique
  kind LearningProgressKind @default(assessment)
  authorUserId String?
  author User? @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  visibility LearningVisibility @default(private)
  score Int?
  maxScore Int?
  coverageStatus ProgressCoverageStatus?
  masteryLevel ProgressMasteryLevel?
  comment String @default("")
  basis String @default("")
  reason String @default("")
  evidence Json @default("{}")
  legacyPayload Json?
  supersedesId String? @unique
  supersedes LearningProgressEvent? @relation("ProgressCorrection", fields: [supersedesId], references: [id], onDelete: Restrict)
  replacement LearningProgressEvent? @relation("ProgressCorrection")
  occurredAt DateTime
  recordedAt DateTime @default(now())
  projection LearningProgressProjection?

  @@index([enrollmentId, occurredAt, id])
  @@index([enrollmentId, recordedAt, id])
  @@index([enrollmentId, taskDefinitionId, visibility, occurredAt, id])
}

model LearningProgressProjection {
  enrollmentId String
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  taskDefinitionId String
  taskDefinition TaskDefinition @relation(fields: [taskDefinitionId], references: [id], onDelete: Restrict)
  eventId String @unique
  event LearningProgressEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  algorithmVersion String @default("latest-published-v1")
  projectedAt DateTime @default(now())

  @@id([enrollmentId, taskDefinitionId])
}

model LearningNotification {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  recipientUserId String
  recipient User @relation(fields: [recipientUserId], references: [id], onDelete: Restrict)
  recipientRole WorkspaceRole
  eventKey String
  type String
  targetType String
  targetId String
  title String
  message String @default("")
  readAt DateTime?
  revision Int @default(0)
  legacyNotificationId String? @unique
  createdAt DateTime @default(now())
  delivery LearningDelivery?

  @@unique([recipientUserId, eventKey])
  @@index([workspaceId, recipientUserId, recipientRole, createdAt, id])
  @@index([workspaceId, recipientUserId, recipientRole, readAt], map: "LearningNotification_recipient_read_idx")
}

model LearningNotificationPreference {
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  emailEnabled Boolean @default(false)
  updatedAt DateTime @updatedAt

  @@id([workspaceId, userId])
}

model LearningDelivery {
  id String @id @default(cuid())
  notificationId String @unique
  notification LearningNotification @relation(fields: [notificationId], references: [id], onDelete: Restrict)
  status LearningDeliveryStatus @default(queued)
  attempts Int @default(0)
  availableAt DateTime @default(now())
  lockedUntil DateTime?
  lockToken String?
  lastErrorCode String @default("")
  provider String @default("")
  deliveredAt DateTime?
  revision Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, availableAt, lockedUntil])
  @@index([createdAt, id])
}
